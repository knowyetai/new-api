# Source build for this host's cached bases. Go 1.25.8 matches local verification.
FROM node:20.20.1-alpine AS web-builder
RUN npm install -g bun@1.4.0 --registry=https://registry.npmjs.org
WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web ./
COPY VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN=true VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM golang:1.25.8-alpine AS go-builder
ENV CGO_ENABLED=0 GOWORK=off GOMAXPROCS=2 GOPROXY=https://goproxy.cn,direct
WORKDIR /build
COPY go.mod go.sum ./
COPY relaykit/go.mod relaykit/go.mod
RUN go mod download
COPY . .
COPY --from=web-builder /build/web/dist web/dist
RUN go build -p 2 -trimpath -buildvcs=false -ldflags "-s -w -X github.com/QuantumNous/new-api/common.Version=$(cat VERSION)" -o /new-api

FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
COPY --from=go-builder /new-api /new-api
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
WORKDIR /data
EXPOSE 3000
ENTRYPOINT ["/new-api"]
