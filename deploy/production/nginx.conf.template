# Render MODEL_GATEWAY_DOMAIN after DNS confirmation. Obtain TLS before exposing login.
server {
    listen 80;
    server_name MODEL_GATEWAY_DOMAIN;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name MODEL_GATEWAY_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/MODEL_GATEWAY_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/MODEL_GATEWAY_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
